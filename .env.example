# ── Server ──────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Database ────────────────────────────────────
DB_PATH=./data/websec.db

# ── Security ────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of scan results
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Logging ─────────────────────────────────────
LOG_LEVEL=info
AUDIT_LOG_DIR=./data/audit-logs
