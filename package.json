{
  "name": "websec-auditor",
  "version": "0.1.0",
  "description": "WebSec Auditor & Stress Tester — All-in-one security auditing and stress testing tool",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outdir=dist --packages=external",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "security",
    "auditor",
    "stress-test",
    "vulnerability",
    "scanner"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.0",
    "cheerio": "^1.0.0",
    "fastify": "^5.2.0",
    "nanoid": "^5.1.0",
    "pino-pretty": "^13.1.3",
    "sql.js": "^1.11.0",
    "undici": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
